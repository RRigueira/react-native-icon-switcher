{
  "name": "react-native-icon-switcher-example-bare",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "sync": "react-native-icon-switcher sync",
    "build:ios": "xcodebuild -workspace ios/IconSwitcherBare.xcworkspace -scheme IconSwitcherBare -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' build",
    "build:android": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.88.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-icon-switcher": "workspace:*",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-monorepo-config": "^0.4.0",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
