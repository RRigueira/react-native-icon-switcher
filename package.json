{
  "name": "react-native-icon-switcher",
  "version": "0.0.0",
  "description": "Switch the app icon at runtime on React Native and Expo from one config file, with the native wiring generated for you",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-icon-switcher-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./config": {
      "react-native-icon-switcher-source": "./src/config.ts",
      "types": "./lib/typescript/src/config.d.ts",
      "default": "./lib/module/config.js"
    },
    "./remote": {
      "react-native-icon-switcher-source": "./src/remote/index.ts",
      "types": "./lib/typescript/src/remote/index.d.ts",
      "default": "./lib/module/remote/index.js"
    },
    "./jest": {
      "types": "./jest/index.d.ts",
      "default": "./jest/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "bin": "./plugin/build/cli.js",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "jest",
    "app.plugin.js",
    "plugin/build",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!plugin/build/**/__tests__"
  ],
  "scripts": {
    "example": "yarn workspace react-native-icon-switcher-example",
    "clean": "del-cli lib plugin/build",
    "prepare": "bob build && yarn build:plugin",
    "build:plugin": "tsc -p plugin",
    "typecheck": "tsc && tsc -p plugin --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "release": "release-it --only-version",
    "check:exports": "node -e \"for (const s of ['react-native-icon-switcher/app.plugin.js','react-native-icon-switcher/jest','react-native-icon-switcher/package.json','react-native-icon-switcher/config','react-native-icon-switcher/remote']) require.resolve(s); console.log('exports ok')\"",
    "example-bare": "yarn workspace react-native-icon-switcher-example-bare"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "expo",
    "expo-config-plugin",
    "app-icon",
    "alternate-icons",
    "icon"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RRigueira/react-native-icon-switcher.git"
  },
  "author": "Rui Rigueira <14238908+RRigueira@users.noreply.github.com> (https://github.com/RRigueira)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RRigueira/react-native-icon-switcher/issues"
  },
  "homepage": "https://github.com/RRigueira/react-native-icon-switcher#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@expo/config-plugins": "^58.0.10",
    "@expo/plist": "^0.10.1",
    "jiti": "^2.7.0",
    "sharp": "^0.35.5",
    "xcode": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "expo": "~58.0.19",
    "jest": "^30.5.2",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.44.1",
    "react-test-renderer": "19.3.0",
    "release-it": "^21.1.1",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "expo": ">=52",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "workspaces": [
    "example",
    "example-bare"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "IconSwitcherSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.iconswitcher"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/example-bare/node_modules",
      "<rootDir>/lib/",
      "<rootDir>/plugin/build"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/plugin/build",
      "<rootDir>/jest",
      "<rootDir>/example/",
      "<rootDir>/example-bare/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/**/__mocks__/**",
      "!src/typetests/**",
      "!src/NativeIconSwitcher.ts",
      "!src/types.ts",
      "!src/register.ts",
      "plugin/src/**/*.ts",
      "!plugin/src/**/__tests__/**",
      "!plugin/src/__fixtures__/**",
      "!plugin/src/types.ts",
      "!**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 90,
        "functions": 85,
        "lines": 95
      }
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "requireBranch": "main",
      "requireCleanWorkingDir": true
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        },
        "infile": "CHANGELOG.md"
      }
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.64.0"
  },
  "resolutions": {
    "release-it/undici": "7.29.1"
  }
}
